# ---------------------------------------------------------------------------
# News Hub — project rules (see CLAUDE.md §6–7)
# ---------------------------------------------------------------------------

# Environment files hold real API keys: never commit them.
# Only the *.example.json templates are tracked.
/env/*.json
!/env/*.example.json

# Generated code (*.g.dart) is intentionally NOT ignored: it is committed (D6).